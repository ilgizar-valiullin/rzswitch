<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Use Workstation GC (concurrent) instead of Server GC to avoid huge virtual memory reservations -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <Version>3.16.0.0</Version>
    <AssemblyVersion>3.16.0.0</AssemblyVersion>
    <FileVersion>3.16.0.0</FileVersion>
    <InformationalVersion>3.16.0.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="setup\**" />
    <Compile Remove="rztracker-aot\**" />
    <Content Remove="setup\**" />
    <Content Remove="rztracker-aot\**" />
    <None Remove="setup\**" />
    <None Remove="rztracker-aot\**" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

  <Target Name="CopyTrackerExe" AfterTargets="Publish" Condition="Exists('$(PublishDir)rzswitch.exe')">
    <!-- Tracker is the same binary in foreground-tracker mode; deploy expects rztracker.exe next to it -->
    <Copy SourceFiles="$(PublishDir)rzswitch.exe" DestinationFiles="$(PublishDir)rztracker.exe" SkipUnchangedFiles="true" />
  </Target>

</Project>
